modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
MERCHANT_ADMIN_EMAIL = "sree.koushikii.2025@gmail.com,sairammargam1910@gmail.com"
SHOPIFY_DEV_STORE_PREVIEW = "true"

[userenv.development]
SHIPROCKET_REASON_OF_EXPORT = "3"
SHIPROCKET_TERMS_OF_INVOICE = "FOB"
CASHFREE_ENVIRONMENT = "sandbox"
CHECKOUT_LIVE_ENABLED = "false"
SHIPROCKET_LIVE_BOOKING_ENABLED = "false"

[objectStorage]
defaultBucketID = "replit-objstore-2eb914e7-4ecd-4b51-a115-f4c594b5616b"

[nix]
channel = "stable-25_05"
