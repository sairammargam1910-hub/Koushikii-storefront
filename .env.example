# Reference only. Set values in Railway's Variables panel; never commit credentials.
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://YOUR-GENERATED-NAME.up.railway.app
SERVE_STOREFRONT=true
CLERK_AUTH_MODE=external
VITE_CLERK_AUTH_MODE=external
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
MERCHANT_ADMIN_EMAIL=
DATABASE_URL=
SITE_MEDIA_STORAGE=r2
R2_ENDPOINT=https://YOUR-ACCOUNT-ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=koushikii-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional development-only connection to the isolated Neon checkout branch.
# Store the actual connection string as a Replit secret; production ignores it.
NEON_DEV_DATABASE_URL=

SHOPIFY_CONNECTION_MODE=direct
SHOPIFY_SHOP_DOMAIN=gtnbsw-x3.myshopify.com
SHOPIFY_PUBLICATION_ID=gid://shopify/Publication/YOUR-PUBLICATION-ID
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# New Dev Dashboard apps owned by the same Shopify organization:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Alternative only if you already have a legacy installed custom-app Admin token:
# SHOPIFY_ADMIN_ACCESS_TOKEN=

# Sandbox is the default. Live mode needs explicit activation and separate credentials.
CASHFREE_ENVIRONMENT=sandbox
CHECKOUT_LIVE_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_LIVE_APP_ID=
CASHFREE_LIVE_SECRET_KEY=

# Shiprocket API credentials and merchant parcel setup.
SHIPROCKET_API_USER_EMAIL=
SHIPROCKET_API_USER_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=500007
SHIPROCKET_PARCEL_WEIGHT_KG=1
SHIPROCKET_PARCEL_LENGTH_CM=35
SHIPROCKET_PARCEL_BREADTH_CM=25
SHIPROCKET_PARCEL_HEIGHT_CM=8
SHIPROCKET_LIVE_BOOKING_ENABLED=false
# Required for international Shiprocket quote orders; set to the merchant's approved export setup.
SHIPROCKET_REASON_OF_EXPORT=3
SHIPROCKET_TERMS_OF_INVOICE=FOB
